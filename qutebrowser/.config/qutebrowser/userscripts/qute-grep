#!/usr/bin/env python3
"""qute-grep — search current page content with ripgrep.

Usage:
    :spawn --userscript qute-grep          (prompt for query)
    :spawn --userscript qute-grep <query>  (search immediately)
    :spawn --userscript qute-grep ?        (previous query)

Requires: ripgrep (rg)
"""
import os
import subprocess
import sys
import tempfile
from pathlib import Path

QUTEBROWSER_DATA = os.environ.get("QUTE_DATA_DIR", os.path.expanduser("~/.local/share/qutebrowser"))


def get_url():
    """Get the current URL via qutebrowser IPC."""
    try:
        r = subprocess.run(
            ["qcmd", "url"],
            capture_output=True, text=True, timeout=5
        )
        if r.returncode == 0:
            return r.stdout.strip()
    except Exception:
        pass

    # Fallback: read from qutebrowser
    try:
        r = subprocess.run(
            ["qutebrowser", "--temp-basedir", ":debug-pyeval", "tabbed_browser.url()"],
            capture_output=True, text=True, timeout=5
        )
        if r.returncode == 0:
            return r.stdout.strip()
    except Exception:
        pass

    return ""


def download_page(url):
    """Download page HTML to a temp file."""
    try:
        r = subprocess.run(
            ["curl", "-sL", "-A", "Mozilla/5.0 qutebrowser", url],
            capture_output=True, text=True, timeout=15
        )
        if r.returncode == 0:
            tf = tempfile.NamedTemporaryFile(mode="w", suffix=".html", delete=False)
            tf.write(r.stdout)
            tf.close()
            return tf.name
    except Exception as e:
        print(f"qute-grep: {e}", file=sys.stderr)
    return None


def grep_page(html_file, query):
    """Grep the downloaded HTML."""
    if not query:
        return []
    try:
        r = subprocess.run(
            ["rg", "--no-heading", "-N", "--", query, html_file],
            capture_output=True, text=True, timeout=10
        )
        return r.stdout.splitlines() if r.stdout else []
    except Exception as e:
        print(f"qute-grep: {e}", file=sys.stderr)
        return []


def main():
    query = sys.argv[1] if len(sys.argv) > 1 else ""

    if not query:
        # Try rofi prompt
        try:
            r = subprocess.run(
                ["rofi", "-dmenu", "-p", "grep:"],
                capture_output=True, text=True, timeout=30
            )
            if r.returncode != 0 or not r.stdout.strip():
                return
            query = r.stdout.strip()
        except FileNotFoundError:
            print("qute-grep: provide a query or install rofi", file=sys.stderr)
            sys.exit(1)

    url = get_url()
    if not url:
        print("qute-grep: no URL", file=sys.stderr)
        sys.exit(1)

    html = download_page(url)
    if not html:
        print("qute-grep: download failed", file=sys.stderr)
        sys.exit(1)

    try:
        matches = grep_page(html, query)
        if not matches:
            print("No matches")
        else:
            for m in matches[:100]:
                print(m)
    finally:
        try:
            os.unlink(html)
        except OSError:
            pass


if __name__ == "__main__":
    main()
