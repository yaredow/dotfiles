#!/usr/bin/env python3
"""qute-copyurl — copy current URL in various formats.

Usage:
    :spawn --userscript qute-copyurl          (plain URL)
    :spawn --userscript qute-copyurl md       (markdown: [title](url))
    :spawn --userscript qute-copyurl bbcode   (BBCode: [url=title]url[/url])
    :spawn --userscript qute-copyurl html     (<a href="url">title</a>)
    :spawn --userscript qute-copyurl org      (org-mode: [[url][title]])
    :spawn --userscript qute-copyurl title    (page title only)
"""
import subprocess
import sys

FMT = sys.argv[1] if len(sys.argv) > 1 else "url"


def get_url():
    try:
        r = subprocess.run(["qcmd", "url"], capture_output=True, text=True, timeout=5)
        if r.returncode == 0:
            return r.stdout.strip()
    except Exception:
        pass
    return ""


def get_title():
    try:
        r = subprocess.run(["qcmd", "title"], capture_output=True, text=True, timeout=5)
        if r.returncode == 0:
            t = r.stdout.strip()
            return t.replace(" - qutebrowser", "").strip()
    except Exception:
        pass
    return ""


def copy_to_clipboard(text):
    """Copy to clipboard using xclip, wl-copy, or pbcopy."""
    for cmd in [["xclip", "-selection", "clipboard"],
                ["wl-copy"],
                ["pbcopy"]]:
        try:
            subprocess.run(cmd, input=text, text=True, check=True, timeout=5)
            return True
        except (FileNotFoundError, subprocess.CalledProcessError):
            continue
    return False


def format_url(url, title, fmt):
    if fmt == "url" or not fmt:
        return url
    if fmt == "title":
        return title or url
    if fmt == "md":
        return f"[{title}]({url})"
    if fmt == "bbcode":
        return f"[url={url}]{title}[/url]"
    if fmt == "html":
        return f'<a href="{url}">{title}</a>'
    if fmt == "org":
        return f"[[{url}][{title}]]"
    return url


def main():
    url = get_url()
    if not url:
        print("qute-copyurl: no URL", file=sys.stderr)
        sys.exit(1)

    title = get_title()
    out = format_url(url, title, FMT)

    if copy_to_clipboard(out):
        print(f"copied ({FMT})")
    else:
        print(out)


if __name__ == "__main__":
    main()
