# Machine-local cursor-agent launchers (installed by cursor, not via stow)
bin/.local/bin/agent
bin/.local/bin/cursor-agent

# Machine-local quickshell state (paths, preferences)
wm/.config/quickshell/state.json
wm/.config/quickshell/state/colors.json

# Generated by theme-set.sh — never edit or commit
theme/.config/theme/current
terminal/.config/kitty/theme.conf
wm/.config/hypr/theme.lua
dev/.config/nvim/lua/theme.lua
terminal/.config/fastfetch/config.jsonc
terminal/.config/btop/themes/theme.theme
media/.config/mpv/script-opts/osc.conf
terminal/.config/herdr/config.toml
terminal/.config/herdr/.plugins.lock
terminal/.config/herdr/release-notes.json
terminal/.config/herdr/session.json
terminal/.config/herdr/*.log
terminal/.config/herdr/*.sock

# Machine-local binaries (installed by install.sh or external tooling)
bin/.local/bin/herdr

# youtube-tui automatic config backups (date-stamped)
media/.config/youtube-tui/main-*.yml

# Generated rmpc themes
media/.config/rmpc/themes/theme.ron
media/.config/rmpc/themes/*.ron

# Local noise
dev/.config/nvim/nvim.log
**/*.log
