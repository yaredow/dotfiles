# Machine-local cursor-agent launchers (installed by cursor, not via stow)
bin/.local/bin/agent
bin/.local/bin/cursor-agent

# Machine-local quickshell state (paths, preferences)
quickshell/.config/quickshell/state.json
quickshell/.config/quickshell/state/colors.json

# Generated by theme-set.sh — never edit or commit
theme/.config/theme/current
kitty/.config/kitty/theme.conf
hypr/.config/hypr/theme.lua
nvim/.config/nvim/lua/theme.lua
fastfetch/.config/fastfetch/config.jsonc
btop/.config/btop/themes/theme.theme
mpv/.config/mpv/script-opts/osc.conf
herdr/.config/herdr/config.toml
qutebrowser/.config/qutebrowser/theme.py

# User-local qutebrowser data
qutebrowser/.config/qutebrowser/quickmarks
qutebrowser/.config/qutebrowser/bookmarks/
qutebrowser/.config/qutebrowser/userscripts/__pycache__/

# Machine-local binaries (installed by install.sh or external tooling)
bin/.local/bin/herdr

# youtube-tui automatic config backups (date-stamped)
youtube-tui/.config/youtube-tui/main-*.yml

# Generated rmpc theme
rmpc/.config/rmpc/themes/theme.ron

# Per-theme rmpc theme files (generated from template)
rmpc/.config/rmpc/themes/*.ron

# Local noise (mpd runtime also covered by mpd/.config/mpd/.gitignore)
nvim/.config/nvim/nvim.log
**/*.log
