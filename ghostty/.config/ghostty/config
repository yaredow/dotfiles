theme =  TokyoNight
window-decoration = none
window-padding-x = 8
window-padding-y = 8

# --- Typography & Spacing ---
font-family = "FiraCode Nerd Font"
font-size = 10

# This is the "Zed secret" — adding vertical breathing room between code lines
adjust-cell-height = 15%

# --- Advanced Rendering ---
# Eliminates dark artifact rings around fonts for perfect GUI-like smoothness
alpha-blending = linear-corrected
